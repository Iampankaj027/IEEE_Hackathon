# ==============================================================================
# VeriCred Frontend - Environment Variables (.env)
# ==============================================================================

# Backend API Base URL (MUST start with VITE_ to be exposed in Vite client code)
# Local development: http://localhost:5000/api
# Production (Vercel): https://<your-render-backend-name>.onrender.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# Institutional Name displayed on public certificates and badges
VITE_ISSUER_INSTITUTION_NAME="Swami Keshvanand Institute of Technology (SKIT)"
