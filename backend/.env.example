# Copy to .env for local development and replace every placeholder.
# Never commit .env or put real credentials in this file.
PORT=5000

# Neon or other PostgreSQL connection string; use sslmode=require for cloud databases.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Use a randomly generated secret with at least 32 characters.
JWT_SECRET="replace_with_a_random_secret_at_least_32_characters"

# Keep stable to preserve verification of certificates signed with this key.
CRYPTO_HMAC_SECRET="replace_with_a_stable_random_secret_at_least_32_characters"
