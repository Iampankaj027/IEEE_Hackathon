# ==============================================================================
# VeriCred Backend - Environment Variables Template (.env)
# ==============================================================================

# Server Listening Port (Render assigns this automatically; set to 5000 for local development)
PORT=5000

# Node Environment
NODE_ENV=production

# PostgreSQL Database Connection String (Neon.tech, Supabase, Render Postgres, or Local)
# Ensure sslmode=require for cloud-hosted databases
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# JWT Secret for Signing Authentication Tokens (minimum 32 characters)
JWT_SECRET="generate_a_secure_random_jwt_secret_key_at_least_32_chars"

# Master Cryptographic Secret for HMAC-SHA256 Signing of Verification QR Codes & Certificates
# (Must be at least 32 characters hex/string - NEVER SHARE THIS)
CRYPTO_HMAC_SECRET="generate_a_64_character_hex_secret_key_for_tamper_proof_signing"

# Public URL of the Frontend Application (Vercel deployment URL)
# Used to generate scannable verification QR codes on issued PDF certificates
# Local: http://localhost:5173
# Production (Render -> points to Vercel): https://<your-project>.vercel.app
FRONTEND_URL="https://<your-project>.vercel.app"

# Institutional Name displayed on PDF certificates and Excel rosters
ISSUER_INSTITUTION_NAME="Swami Keshvanand Institute of Technology (SKIT)"
