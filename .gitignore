# ==============================================================================
# IEE_Hackathon / VeriCred Platform - Root .gitignore
# ==============================================================================

# Dependencies
node_modules/
**/node_modules/

# Environment Variables & Secrets
.env
.env.*
*.env
**/.env
**/.env.*
!.env.example
!**/.env.example

# Build Outputs
dist/
**/dist/
build/
**/build/
.vite/
**/.vite/

# Uploaded Assets & Generated PDFs
uploads/*
!uploads/**/.gitkeep
**/uploads/*
!**/uploads/**/.gitkeep

# Logs
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*

# OS & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Database & Cache
*.sqlite*
*.db*
.cache/
coverage/
